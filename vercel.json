{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/worker",
      "destination": "/worker/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/worker/",
      "destination": "/worker.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
